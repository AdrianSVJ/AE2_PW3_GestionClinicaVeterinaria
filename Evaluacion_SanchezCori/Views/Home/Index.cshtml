@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-verde">

<div class="row align-items-center">

<div class="col-lg-7">

<span class="badge badge-verde mb-3">
    Clínica Veterinaria
</span>

<h1 class="display-4 fw-bold">

    Cuidamos a quienes
    <span>forman parte de tu familia</span>

</h1>

<p class="lead">

    Registra tus mascotas, conoce nuestros
    servicios y agenda citas veterinarias
    de manera rápida y sencilla.

</p>

@if (User.Identity?.IsAuthenticated != true)
{
    <a asp-controller="Account"
       asp-action="Register"
       class="btn btn-militar btn-lg">

        Crear cuenta

    </a>

    <a asp-controller="Account"
       asp-action="Login"
       class="btn btn-outline-militar btn-lg ms-2">

        Iniciar sesión

    </a>
}

@if (User.IsInRole("Cliente"))
{
    <a asp-controller="Citas"
       asp-action="Create"
       class="btn btn-militar btn-lg">

        Solicitar cita

    </a>
}

@if (User.IsInRole("Administrador"))
{
    <a asp-controller="Home"
       asp-action="Dashboard"
       class="btn btn-militar btn-lg">

        Ir al dashboard

    </a>
}

</div>

<div class="col-lg-5 text-center">

<div class="icono-mascota">
    🐾
</div>

</div>

</div>

</section>

<div class="row g-4 mt-3">

<div class="col-md-4">

<div class="card tarjeta-verde h-100">

<div class="card-body">

<div class="mascota-icono">
    🐶
</div>

<h4>
    Tus mascotas
</h4>

<p>
    Registra y administra fácilmente
    la información de tus mascotas.
</p>

</div>

</div>

</div>

<div class="col-md-4">

<div class="card tarjeta-verde h-100">

<div class="card-body">

<div class="mascota-icono">
    🩺
</div>

<h4>
    Servicios
</h4>

<p>
    Consulta nuestros servicios
    veterinarios y sus precios.
</p>

</div>

</div>

</div>

<div class="col-md-4">

<div class="card tarjeta-verde h-100">

<div class="card-body">

<div class="mascota-icono">
    📅
</div>

<h4>
    Citas
</h4>

<p>
    Solicita atención veterinaria
    para cualquiera de tus mascotas.
</p>

</div>

</div>

</div>

</div>