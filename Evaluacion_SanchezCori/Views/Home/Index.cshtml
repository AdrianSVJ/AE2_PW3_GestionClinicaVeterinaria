@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-verde">

    <div class="row align-items-center">

        <div class="col-lg-7">

            <span class="badge badge-verde mb-3">
                Clínica Veterinaria
            </span>

            <h1 class="display-4 fw-bold">
                Cuidamos a quienes
                <span>forman parte de tu familia</span>
            </h1>

            <p class="lead">
                Registra tus mascotas, consulta nuestros servicios
                y agenda citas veterinarias de forma rápida y sencilla.
            </p>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-militar btn-lg">
                    Crear cuenta
                </a>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-outline-militar btn-lg ms-2">
                    Iniciar sesión
                </a>
            }

            @if (User.IsInRole("Cliente"))
            {
                <a asp-controller="Citas"
                   asp-action="Create"
                   class="btn btn-militar btn-lg">
                    Solicitar cita
                </a>
            }

            @if (User.IsInRole("Administrador"))
            {
                <a asp-controller="Home"
                   asp-action="Dashboard"
                   class="btn btn-militar btn-lg">
                    Ir al Dashboard
                </a>
            }

        </div>

        <div class="col-lg-5 text-center">

            <div class="huella-principal">
                🐾
            </div>

        </div>

    </div>

</section>


<section class="py-5">

    <div class="text-center mb-4">

        <h2 class="titulo-verde">
            Todo lo que necesitas
        </h2>

        <p class="text-muted">
            Gestiona el cuidado de tus mascotas desde un solo lugar.
        </p>

    </div>


    <div class="row g-4">

        <div class="col-md-4">

            <div class="card tarjeta-verde h-100">

                <div class="card-body p-4">

                    <div class="icono-card">
                        🐶
                    </div>

                    <h4>
                        Tus mascotas
                    </h4>

                    <p class="text-muted">
                        Registra y administra fácilmente
                        la información de tus mascotas.
                    </p>

                    @if (User.IsInRole("Cliente"))
                    {
                        <a asp-controller="Mascotas"
                           asp-action="Index"
                           class="link-verde">

                            Ver mis mascotas →

                        </a>
                    }

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card tarjeta-verde h-100">

                <div class="card-body p-4">

                    <div class="icono-card">
                        🩺
                    </div>

                    <h4>
                        Servicios veterinarios
                    </h4>

                    <p class="text-muted">
                        Consulta nuestros servicios veterinarios
                        y conoce los precios disponibles.
                    </p>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="ServiciosVeterinarios"
                           asp-action="Index"
                           class="link-verde">

                            Ver servicios →

                        </a>
                    }

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card tarjeta-verde h-100">

                <div class="card-body p-4">

                    <div class="icono-card">
                        📅
                    </div>

                    <h4>
                        Citas médicas
                    </h4>

                    <p class="text-muted">
                        Programa fácilmente una atención
                        veterinaria para tu mascota.
                    </p>

                    @if (User.IsInRole("Cliente"))
                    {
                        <a asp-controller="Citas"
                           asp-action="Index"
                           class="link-verde">

                            Ver mis citas →

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</section>