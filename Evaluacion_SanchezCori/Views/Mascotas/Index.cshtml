@model IEnumerable<Mascota>

@{
    ViewData["Title"] = "Mis mascotas";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="titulo-verde">
            Mis mascotas
        </h2>

        <p class="text-muted">
            Administra las mascotas asociadas a tu cuenta.
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-militar">

        + Registrar mascota

    </a>

</div>

@if (!Model.Any())
{
    <div class="card tarjeta-verde">

        <div class="card-body text-center p-5">

            <div style="font-size:60px;">
                🐾
            </div>

            <h4 class="mt-3">
                No tienes mascotas registradas
            </h4>

            <p class="text-muted">
                Registra tu primera mascota para poder solicitar una cita.
            </p>

            <a asp-action="Create"
               class="btn btn-militar">

                Registrar mascota

            </a>

        </div>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var mascota in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card tarjeta-verde h-100">

                    <div class="card-body p-4">

                        <div class="icono-card">
                            🐾
                        </div>

                        <h4>
                            @mascota.Nombre
                        </h4>

                        <p class="mb-1">

                            <strong>
                                Especie:
                            </strong>

                            @mascota.Especie

                        </p>

                        <p>

                            <strong>
                                Raza:
                            </strong>

                            @mascota.Raza

                        </p>

                        <a asp-action="Edit"
                           asp-route-id="@mascota.Id"
                           class="btn btn-outline-militar btn-sm">

                            Editar

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@mascota.Id"
                           class="btn btn-outline-danger btn-sm">

                            Eliminar

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}