<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Clínica Verde
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark navbar-principal">

            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    🐾 Clínica Verde

                </a>


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="menuPrincipal">


                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Inicio

                            </a>

                        </li>


                        @if (User.Identity?.IsAuthenticated == true)
                        {

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="ServiciosVeterinarios"
                                   asp-action="Index">

                                    Servicios

                                </a>

                            </li>


                            @if (User.IsInRole("Cliente"))
                            {

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Mascotas"
                                       asp-action="Index">

                                        Mis mascotas

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Citas"
                                       asp-action="Index">

                                        Mis citas

                                    </a>

                                </li>

                            }


                            @if (User.IsInRole("Administrador"))
                            {

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Home"
                                       asp-action="Dashboard">

                                        Dashboard

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Citas"
                                       asp-action="Index">

                                        Citas

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Reportes"
                                       asp-action="Index">

                                        Reportes

                                    </a>

                                </li>

                            }

                        }

                    </ul>


                    <ul class="navbar-nav align-items-lg-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {

                            <li class="nav-item me-lg-3">

                                <span class="usuario-navbar">

                                    👤 @User.Identity.Name

                                </span>

                            </li>


                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    <button type="submit"
                                            class="btn btn-outline-light btn-sm">

                                        Cerrar sesión

                                    </button>

                                </form>

                            </li>

                        }
                        else
                        {

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Iniciar sesión

                                </a>

                            </li>


                            <li class="nav-item ms-lg-2">

                                <a class="btn btn-claro"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Crear cuenta

                                </a>

                            </li>

                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <main class="container contenido-principal">

        @if (TempData["Mensaje"] != null)
        {

            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                @TempData["Mensaje"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>

        }


        @if (TempData["Error"] != null)
        {

            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>

        }


        @RenderBody()

    </main>


    <footer class="footer-verde">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <h5 class="mb-1">
                        🐾 Clínica Verde
                    </h5>

                    <small>
                        Cuidado profesional para tus mascotas.
                    </small>

                </div>


                <div class="col-md-6 text-md-end mt-3 mt-md-0">

                    <small>
                        Evaluacion_SanchezCori
                    </small>

                    <br />

                    <small>
                        © @DateTime.Now.Year
                    </small>

                </div>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>